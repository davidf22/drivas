SECRET_KEY=replace-with-a-long-random-secret-key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://rideuser:ridepass@localhost:5432/rideconnect_db

# WhatsApp Cloud API (developers.facebook.com — WhatsApp product, System User token)
WHATSAPP_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-and-use-it-in-the-meta-dashboard
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_API_VERSION=v21.0

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
