# Copy this file to .env on your production server and fill in the values.
# Never commit the actual .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=drivas.online,www.drivas.online
SITE_URL=https://www.drivas.online

# PostgreSQL (provided by your host, e.g. Railway, Supabase, or self-hosted)
DATABASE_URL=postgres://user:password@host:5432/drivas

# Redis (provided by your host or self-hosted)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Drivas <your-email@gmail.com>

# Paystack
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
